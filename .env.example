# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Neon Postgres via Vercel Marketplace) ---
# When unset, the app runs against in-memory seed data (development mode).
DATABASE_URL=

# --- Auth (Clerk) ---
# When unset, the app runs in guest-only mode (no sign-in surface).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Payments (Stripe: PAY-1) ---
# The Stripe rail activates when BOTH keys are set; otherwise the payment
# orchestration layer uses the mock provider. Real values live in .env.local.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret for /api/webhooks/stripe (from the dashboard webhook endpoint
# or `stripe listen`); webhook processing is disabled when unset.
STRIPE_WEBHOOK_SECRET=
# Signing secret for /api/webhooks/stripe/connect — a SEPARATE endpoint
# configured to "listen on connected accounts" (account.updated drives the
# PAY-4 health monitor); webhook processing is disabled when unset.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Sandbox Connect account used as the payout destination for all seeded US
# organisations in dev (create one fully API-onboarded test account).
STRIPE_SEED_CONNECT_ACCOUNT_ID=

# --- Cache / rate limiting (Upstash via Vercel Marketplace) ---
# Vercel provisions KV_REST_API_URL + KV_REST_API_TOKEN; the Upstash SDK also
# accepts UPSTASH_REDIS_REST_* aliases. When unset, rate limiting falls back to
# an in-memory limiter (dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email (Resend via Vercel Marketplace; console adapter when unset) ---
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=
# Optional override; defaults to bookings@$RESEND_EMAIL_DOMAIN when set.
EMAIL_FROM=bookings@example.com

# --- Analytics (PostHog via Vercel Marketplace) ---
# Provisioned by `vercel integration add posthog`; every capture path no-ops
# when unset (dev offline mode). NEXT_PUBLIC_POSTHOG_HOST is eu or us region.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Error monitoring (Sentry via Vercel Marketplace; inert when unset) ---
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (source-map upload); never exposed to the browser.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Google Search Console verification (HTML-tag method; emitted in <head>) ---
GOOGLE_SITE_VERIFICATION=
